<?xml version="1.0" encoding="utf-8"?>
<!-- Même organisation que le prototype Capacitor : carte plein écran, fond de carte en haut à gauche,
     boutons carte à droite, panneau en bas avec quatre onglets (Sortie, Randos, Hors ligne, Mesures). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2EFE9">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        maplibre:maplibre_cameraTargetLat="43.172"
        maplibre:maplibre_cameraTargetLng="5.6"
        maplibre:maplibre_cameraZoom="14"
        maplibre:maplibre_uiCompassMarginTop="64dp" />

    <!-- Encadrer une zone (randos OSM) : capte le doigt au-dessus de la carte -->
    <fr.assomoutain.proto.FrameDrawView
        android:id="@+id/frameDraw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/card_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Rechercher un lieu"
            android:src="@android:drawable/ic_menu_search" />

        <Button
            android:id="@+id/btnLayer"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/chkSlopes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pentes" />

        <CheckBox
            android:id="@+id/chkShade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ombres" />
    </LinearLayout>

    <!-- Recherche de lieux (remplace la barre du haut pendant la saisie) -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <EditText
                android:id="@+id/searchText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ville, département, sommet, lieu…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapWords|textNoSuggestions"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSearchClose"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Fermer la recherche"
                android:text="✕" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/searchScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/searchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Lieu choisi : « Y aller » ouvre Google Maps -->
    <LinearLayout
        android:id="@+id/targetBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/card_bg"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/targetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="14sp" />

        <LinearLayout style="@style/Row">
            <Button android:id="@+id/btnGo" style="@style/Btn.Primary" android:text="Y aller (Google Maps)" />
            <Button android:id="@+id/btnTargetClear" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="48dp" android:layout_height="wrap_content"
                android:contentDescription="Effacer le lieu choisi" android:text="✕" />
        </LinearLayout>
    </LinearLayout>

    <!-- Film des ombres du relief (8 h → midi, toutes les 30 min), avec l'heure en gros -->
    <LinearLayout
        android:id="@+id/shadeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/card_bg"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shadeTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="--:--"
                android:textColor="#1D2421"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shadeSun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/shadeClose"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:contentDescription="Fermer les ombres"
                android:text="✕" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/shadePlay"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:contentDescription="Lire le film"
                android:text="▶" />

            <SeekBar
                android:id="@+id/shadeSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/shadeDate"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shadeMsg"
            style="@style/Hint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/frameBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/frameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trace un rectangle du doigt sur la zone"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/chkOnPaths"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="recaler sur sentiers"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnFrameCancel"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annuler"
            android:textAllCaps="false" />
    </LinearLayout>


    <!-- Boutons toujours visibles, même en mode nature : me localiser, mode avion, mode poche -->
    <LinearLayout
        android:id="@+id/quickButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">
        <!-- Flèche : affiche ou cache toutes les icônes (choix retenu) -->
        <Button
            android:id="@+id/btnQuickToggle"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/round_btn"
            android:contentDescription="Afficher ou cacher les icônes"
            android:elevation="4dp"
            android:padding="0dp"
            android:text="▸"
            android:textColor="#1D2421"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/quickIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <ImageButton
                android:id="@+id/btnLocate"
                android:layout_marginTop="8dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Me localiser"
                android:elevation="4dp"
                android:src="@android:drawable/ic_menu_mylocation" />

            <Button
                android:id="@+id/btnQuickSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Rechercher un lieu"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="🔍"
                android:textColor="#1D2421"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnQuickLayer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Changer de fond de carte"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="🗺"
                android:textColor="#1D2421"
                android:textSize="20sp" />


            <Button
                android:id="@+id/btnQuickAvion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Mode avion (sans réseau, Wi-Fi ni Bluetooth)"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="✈"
                android:textColor="#1D2421"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnPoche"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Mode poche (écran noir quand le téléphone est vertical)"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="👖"
                android:textColor="#1D2421"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnQuickDraw"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Tracer un parcours au doigt"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="✏"
                android:textColor="#1D2421"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnQuickSlopes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Pentes"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="⛰"
                android:textColor="#1D2421"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnQuickShade"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/round_btn"
                android:contentDescription="Ombres du relief"
                android:elevation="4dp"
                android:padding="0dp"
                android:text="🌗"
                android:textColor="#1D2421"
                android:textSize="20sp" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sheet_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/handle"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:contentDescription="Ouvrir ou fermer le panneau">

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/handle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Croix à gauche : à droite elle gênait les icônes de la carte -->
            <Button android:id="@+id/btnNature" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="40dp" android:layout_height="wrap_content"
                android:contentDescription="Masquer l'interface (mode nature)" android:text="✕"
                android:textColor="@color/muted" android:textSize="18sp" />
            <Button android:id="@+id/tabSortie" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2"
                android:text="Sortie" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/tabRandos" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2"
                android:text="Randos" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/tabForets" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2"
                android:text="Forêts" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/tabOffline" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2"
                android:text="Hors ligne" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/tabMesures" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2"
                android:text="Mesures" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/tabVersions" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:minWidth="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2"
                android:text="Versions" android:textAllCaps="false" android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

        <ScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp">

                <!-- Onglet Sortie -->
                <LinearLayout
                    android:id="@+id/paneSortie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/statDist" style="@style/Stat" />
                        <TextView android:id="@+id/statGain" style="@style/Stat" />
                        <TextView android:id="@+id/statTime" style="@style/Stat" />
                        <TextView android:id="@+id/statPoints" style="@style/Stat" />
                    </LinearLayout>

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnMode" style="@style/Btn" />
                        <Button android:id="@+id/btnSource" style="@style/Btn" />
                    </LinearLayout>

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnStart" style="@style/Btn.Primary" />
                        <CheckBox android:id="@+id/chkFollow" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" android:text="Suivre" />
                    </LinearLayout>

                    <TextView android:id="@+id/gpsReasons" style="@style/Hint" android:visibility="gone" />

                    <!-- Économie batterie : Android interdit de couper soi-même, on ouvre le réglage (BatterySettings.java) -->
                    <TextView style="@style/Hint"
                        android:text="Économie batterie : le mode avion coupe tout, le GPS et les cartes téléchargées continuent de marcher." />
                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnAvion" style="@style/Btn" android:text="✈ Avion" />
                        <Button android:id="@+id/btnWifi" style="@style/Btn" android:text="Wi-Fi" />
                        <Button android:id="@+id/btnDonnees" style="@style/Btn" android:text="Données" />
                        <Button android:id="@+id/btnBluetooth" style="@style/Btn" android:text="Bluetooth" />
                    </LinearLayout>


                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnExport" style="@style/Btn" android:text="Exporter GPX" />
                        <Button android:id="@+id/btnImport" style="@style/Btn" android:text="Importer GPX" />
                        <Button android:id="@+id/btnClearImport" style="@style/Btn" android:text="Effacer l'import"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Onglet Randos : randos balisées libres (OpenStreetMap) d'une zone encadrée -->
                <LinearLayout
                    android:id="@+id/paneRandos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/trailsAttribution" style="@style/Hint" />

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnFrame" style="@style/Btn.Primary" android:text="Encadrer une zone" />
                        <Button android:id="@+id/btnDrawPath" style="@style/Btn" android:text="✏ Tracer au doigt" />
                        <Button android:id="@+id/btnTrailsView" style="@style/Btn" android:text="Zone affichée" />
                    </LinearLayout>

                    <TextView android:id="@+id/trailsInfo" style="@style/Hint" android:visibility="gone" />
                    <TextView android:id="@+id/webInfo" style="@style/Hint" android:visibility="gone" />

                    <!-- Rando trouvée sur le web par Claude (point orange) -->
                    <LinearLayout
                        android:id="@+id/hikeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/hike_card"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView android:id="@+id/hikeName" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                            android:textColor="#1D2421" />
                        <TextView android:id="@+id/hikeDetail" style="@style/Hint" android:layout_marginTop="2dp" />
                        <TextView android:id="@+id/hikeResume" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp"
                            android:textColor="#1D2421" />

                        <LinearLayout style="@style/Row">
                            <Button android:id="@+id/btnHikeOpen" style="@style/Btn.Primary" android:text="Ouvrir la page" />
                            <Button android:id="@+id/btnHikeGo" style="@style/Btn" android:text="Y aller" />
                            <Button android:id="@+id/btnHikeClose" style="@style/Btn" android:text="Fermer" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/trailCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/trail_card"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView android:id="@+id/trailName" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                            android:textColor="#1D2421" />
                        <TextView android:id="@+id/trailKind" style="@style/Hint" android:layout_marginTop="2dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:orientation="horizontal">
                            <TextView android:id="@+id/trailDist" style="@style/Stat" />
                            <TextView android:id="@+id/trailGain" style="@style/Stat" />
                            <TextView android:id="@+id/trailLoss" style="@style/Stat" />
                            <TextView android:id="@+id/trailTime" style="@style/Stat" />
                        </LinearLayout>

                        <!-- Profil en coupe (ProfileView, même dessin que Profile.tsx) et pente sous le doigt -->
                        <TextView android:id="@+id/trailSlope" style="@style/Hint" android:layout_marginTop="6dp"
                            android:visibility="gone" />
                        <fr.assomoutain.proto.ProfileView android:id="@+id/trailProfile"
                            android:layout_width="match_parent" android:layout_height="120dp"
                            android:layout_marginTop="6dp" android:visibility="gone" />

                        <TextView android:id="@+id/trailAltError" style="@style/Hint" android:visibility="gone"
                            android:text="Altitudes indisponibles (service IGN injoignable) : le GPX sera exporté sans altitude." />

                        <LinearLayout style="@style/Row">
                            <Button android:id="@+id/btnTrailExport" style="@style/Btn.Primary" android:text="Exporter GPX" />
                            <Button android:id="@+id/btnTrailClose" style="@style/Btn" android:text="Fermer" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/trailList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/hikeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <Button android:id="@+id/btnTrailsClear" style="@style/Btn" android:layout_width="match_parent"
                        android:layout_weight="0" android:text="Effacer les randos de la carte" android:visibility="gone" />

                    <TextView style="@style/Hint" android:text="Mot de passe IA (recherche des randos sur le web par Claude)" />
                    <EditText android:id="@+id/editIaPassword" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textPassword"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <!-- Onglet Forêts : forêts par essence (BD Forêt IGN) d'une zone -->
                <LinearLayout
                    android:id="@+id/paneForets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/forestsAttribution" style="@style/Hint" />

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnForestsView" style="@style/Btn.Primary" android:text="Zone affichée" />
                        <Button android:id="@+id/btnForestsFrame" style="@style/Btn" android:text="Encadrer une zone" />
                    </LinearLayout>

                    <TextView android:id="@+id/forestsInfo" style="@style/Hint" android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/forestList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnForestsAll" style="@style/Btn" android:text="Toutes les essences" android:visibility="gone" />
                        <Button android:id="@+id/btnForestsClear" style="@style/Btn" android:text="Effacer les forêts" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Onglet Hors ligne -->
                <LinearLayout
                    android:id="@+id/paneOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/Hint" android:text="Clé IGN pour le SCAN 25" />
                    <EditText android:id="@+id/editKey" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="text|textNoSuggestions"
                        android:importantForAutofill="no" android:hint="clé cartes.gouv.fr" />

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnTestKey" style="@style/Btn" android:text="Tester la clé" />
                        <Button android:id="@+id/btnNetwork" style="@style/Btn" />
                    </LinearLayout>

                    <TextView android:id="@+id/offlineHint" style="@style/Hint" />

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnDownload" style="@style/Btn.Primary" android:text="Tracer un rectangle" />
                    </LinearLayout>

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnCancel" style="@style/Btn" android:text="Annuler" />
                        <Button android:id="@+id/btnClear" style="@style/Btn" android:text="Vider" />
                    </LinearLayout>

                    <ProgressBar android:id="@+id/progress" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:visibility="gone" />
                    <TextView android:id="@+id/offlineInfo" style="@style/Hint" />
                </LinearLayout>

                <!-- Onglet Versions : historique embarqué par la CI (assets/changelog.json) -->
                <LinearLayout
                    android:id="@+id/paneVersions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Onglet Mesures -->
                <LinearLayout
                    android:id="@+id/paneMesures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/metrics" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:lineSpacingExtra="6dp" android:textSize="14sp" />

                    <LinearLayout style="@style/Row">
                        <Button android:id="@+id/btnRefresh" style="@style/Btn" android:text="Rafraîchir" />
                        <Button android:id="@+id/btnBench" style="@style/Btn" android:text="Bench caméra 30 s" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <TextView android:id="@+id/status" style="@style/Hint" android:visibility="gone" />
    </LinearLayout>

    <!-- Mode nature : petit bouton discret pour faire revenir l'interface -->
    <Button
        android:id="@+id/btnRestore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="28dp"
        android:alpha="0.7"
        android:background="@drawable/round_btn"
        android:contentDescription="Afficher les boutons"
        android:padding="0dp"
        android:text="☰"
        android:textColor="#1D2421"
        android:textSize="20sp"
        android:visibility="gone" />
</FrameLayout>
